PORT=8080
# ---- PostgreSQL Database Connection (OWASP A02:2021 Cryptographic & Secret Management) ----
# Option A: Discrete PostgreSQL Environment Variables
PGUSER=triplee_app
PGPASSWORD=replace-with-strong-db-password
PGHOST=localhost
PGPORT=5432
PGDATABASE=triplee

# Option B: Full Connection URI (takes precedence if set)
DATABASE_URL=postgres://triplee_app:your-password@localhost:5432/triplee
DB_SSL=off
DB_POOL_MAX=10

# ---- Cryptographic JWT Signing Secret (minimum 256-bit / 32+ random characters) ----
JWT_SECRET=replace-with-a-long-random-256-bit-hex-secret-string
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Folder containing the HTML/JS/CSS (served by Express in dev; use Nginx in production)
FRONTEND_DIR=../Finance_Inventory
COOKIE_SECURE=false

# ---- Online shop: business details shown on the shop, the Help page and in customer emails ----
# Leave a line empty to hide it. Nothing here is secret: customers see it.
SHOP_PHONE=
SHOP_EMAIL=
SHOP_VIBER=
SHOP_MESSENGER=
SHOP_ADDRESS=
SHOP_HOURS=
DELIVERY_FEE=150
DELIVERY_AREAS=
DELIVERY_LEAD_TIME=
PICKUP_NOTE=
REFUND_WINDOW_DAYS=7
# Needed for the "View my orders" link in emails and for Xendit redirects, e.g. https://shop.yourdomain.com
APP_BASE_URL=
# Customer emails need ONE of these (see mailer.js): Gmail app password, or Mailgun
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Store / Cash shift hours (HH:MM 24-hr format; defaults to 08:00 and 17:00)
BUSINESS_OPEN=08:00
BUSINESS_CLOSE=17:00
# End of day: this many minutes before BUSINESS_CLOSE every open cash shift MUST be counted and closed. The count-and-close window opens by itself,
# cannot be dismissed, and the server refuses sales on that shift until it is closed. 15 = 4:45 PM for a 5:00 PM close. 0 turns it off.
SHIFT_FORCE_CLOSE_MINUTES=15
# true = shifts can only be opened during store hours and not in that last window (set this in production; leave it off on a development computer)
ENFORCE_STORE_HOURS=false

# ---- Security alerts (optional): email the owner on repeated failed sign-ins or a locked administrator account ----
SECURITY_ALERT_EMAIL=
ALERT_FAIL_THRESHOLD=10
ALERT_WINDOW_MIN=10
ALERT_COOLDOWN_MIN=30
# Production must use HTTPS: set NODE_ENV=production, COOKIE_SECURE=true and a JWT_SECRET of 32+ random characters

# ---- Two-step sign-in: EVERY sign-in asks for a one-time code sent by email or text message (the person chooses) ----
# On by default. LOGIN_OTP=off is for a throw-away development server only (the test walk-throughs cannot type a code) - never in production.
# LOGIN_OTP=off
LOGIN_OTP_TTL_MIN=5
# Email codes need GMAIL_USER/GMAIL_APP_PASSWORD or Mailgun above; text codes need TEXTBEE_API_KEY/TEXTBEE_DEVICE_ID. If neither is set up on a
# developer computer, the code is printed in the server console instead (never in production).

# ---- Device limit per role: how many devices can be signed in to ONE account at the same time ----
# role=number, comma separated. Signing in over the limit signs the OLDEST device out ("signed in on another device"); logging out frees a place.
# Default: the administrator 1, each cashier 1 (one drawer, one device), customers 3 (phone, laptop, tablet). A role that is not listed has no limit.
SESSION_LIMITS=finance=1,cashier=1,customer=3

# ---- Rate limits (per connection / IP address) ----
# Sign-in, sign-up and one-time-code requests share AUTH_RATE_LIMIT per 10 minutes. Invitations an administrator sends have their own INVITE_RATE_LIMIT.
AUTH_RATE_LIMIT=40
INVITE_RATE_LIMIT=30

# ---- Unpaid balances and Finance approvals ----
# First confirmed order payment + due days. Finance may record a later due date.
BALANCE_DUE_DAYS=7
# Hold an open, partly paid order this many days after its balance due date (0 = immediately when due).
BALANCE_GRACE_DAYS=7
# A single Finance user can grant credit up to this outstanding balance in PHP.
# Above the limit a second active, signed-in Finance user must approve. 0 requires two for every positive balance.
CREDIT_EXCEPTION_LIMIT_PHP=10000
